<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CSV TXT Import Export</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f4f4f4;
            padding: 20px;
        }

        .container {
            max-width: 1300px;
            margin: auto;
            background: white;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        }

        h2 {
            margin-bottom: 20px;
        }

        input[type=file] {
            margin-bottom: 15px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
            display: block;
            overflow: auto;
        }

        th,
        td {
            border: 1px solid #ccc;
            padding: 8px;
            min-width: 140px;
            text-align: left;
        }

        th {
            background: #222;
            color: white;
        }

        td input {
            width: 100%;
            border: none;
            outline: none;
            padding: 5px;
            box-sizing: border-box;
        }

        .btn {
            padding: 8px 14px;
            border: none;
            border-radius: 5px;
            color: white;
            cursor: pointer;
            font-weight: bold;
        }

        .remove-btn {
            background: red;
        }

        .download-btn {
            background: green;
        }

        .topbar {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            align-items: center;
        }
    </style>
</head>

<body>

    <div class="container">

        <h2>Import CSV / TXT File</h2>

        <div class="topbar">

            <input type="file"
                   id="fileInput"
                   accept=".csv,text/csv,.txt,text/plain">

            <button class="btn download-btn"
                    onclick="downloadFile()">
                Generate Output File
            </button>

        </div>

        <table id="dataTable"></table>

    </div>

    <script>

        let headers = []
        let rows = []
        let currentSeparator = ","

        document
            .getElementById("fileInput")
            .addEventListener("change", handleFile)

        function handleFile(event) {

            const file = event.target.files[0]

            if (!file) {
                return
            }

            const reader = new FileReader()

            reader.onload = function (e) {

                const text = e.target.result.trim()

                const lines = text.split(/\r?\n/)

                if (lines.length === 0) {
                    alert("Empty File")
                    return
                }

                // Detect separator
                currentSeparator = ","

                if (lines[0].includes("|")) {
                    currentSeparator = "|"
                }
                else if (lines[0].includes("\t")) {
                    currentSeparator = "\t"
                }

                // Headers
                headers = lines[0]
                    .split(currentSeparator)
                    .map(h => h.trim())

                rows = []

                // Data rows
                for (let i = 1; i < lines.length; i++) {

                    if (lines[i].trim() === "") {
                        continue
                    }

                    const cols = lines[i].split(currentSeparator)

                    rows.push(cols)
                }

                renderTable()
            }

            reader.readAsText(file)
        }

        function renderTable() {

            const table = document.getElementById("dataTable")

            table.innerHTML = ""

            // THEAD
            const thead = document.createElement("thead")

            const headerRow = document.createElement("tr")

            headers.forEach(header => {

                const th = document.createElement("th")

                th.innerText = header

                headerRow.appendChild(th)
            })

            const actionTh = document.createElement("th")

            actionTh.innerText = "Action"

            headerRow.appendChild(actionTh)

            thead.appendChild(headerRow)

            table.appendChild(thead)

            // TBODY
            const tbody = document.createElement("tbody")

            rows.forEach((row, rowIndex) => {

                const tr = document.createElement("tr")

                headers.forEach((_, colIndex) => {

                    const td = document.createElement("td")

                    const input = document.createElement("input")

                    input.value = row[colIndex] || ""

                    input.oninput = function () {

                        rows[rowIndex][colIndex] = this.value
                    }

                    td.appendChild(input)

                    tr.appendChild(td)
                })

                // Remove Button
                const actionTd = document.createElement("td")

                const removeBtn = document.createElement("button")

                removeBtn.innerText = "Remove"

                removeBtn.className = "btn remove-btn"

                removeBtn.onclick = function () {

                    rows.splice(rowIndex, 1)

                    renderTable()
                }

                actionTd.appendChild(removeBtn)

                tr.appendChild(actionTd)

                tbody.appendChild(tr)
            })

            table.appendChild(tbody)
        }

        function downloadFile() {

            if (headers.length === 0) {

                alert("No data available")

                return
            }

            let output = headers.join(currentSeparator) + "\n"

            rows.forEach(row => {

                output += row.join(currentSeparator) + "\n"
            })

            const originalFile =
                document.getElementById("fileInput").files[0]

            let mimeType = "text/csv;charset=utf-8;"
            let extension = "csv"

            if (originalFile.name.endsWith(".txt")) {

                mimeType = "text/plain;charset=utf-8;"
                extension = "txt"
            }

            const blob = new Blob(
                [output],
                { type: mimeType }
            )

            const link = document.createElement("a")

            link.href = URL.createObjectURL(blob)

            link.download = "output." + extension

            link.click()
        }

    </script>

</body>

</html>