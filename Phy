<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Var Margin Calculator</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 30px;
      max-width: 600px;
    }
    input[type="number"], input[type="text"] {
      width: 100%;
      padding: 8px;
      margin: 8px 0;
    }
    .radio-group {
      margin: 10px 0;
    }
    .radio-group label {
      margin-right: 15px;
    }
    #output {
      font-weight: bold;
      margin-top: 20px;
      background: #e6f3ff;
      padding: 12px;
      border-left: 5px solid #007acc;
    }
  </style>
</head>
<body>

  <h2>📊 Var Margin Calculator</h2>

  <label>Upload File (optional):</label>
  <input type="file" id="fileUpload"><br><br>

  <label>Scrip Code:</label>
  <input type="text" id="scripCode" placeholder="Enter scrip code">

  <label>Var Value (%):</label>
  <input type="number" id="var" placeholder="Enter VAR value">

  <label>LTP (Last Traded Price):</label>
  <input type="number" id="ltp" placeholder="Enter LTP value">

  <label>Quantity (Qty):</label>
  <input type="number" id="qty" placeholder="Enter quantity">

  <div class="radio-group">
    <label><input type="radio" name="percent" value="5" checked> 1 (5%)</label>
    <label><input type="radio" name="percent" value="10"> 2 (10%)</label>
    <label><input type="radio" name="percent" value="15"> 3 (15%)</label>
    <label><input type="radio" name="percent" value="20"> 4 (20%)</label>
    <label><input type="radio" name="percent" value="25"> 5 (25%)</label>
  </div>

  <button onclick="calculateMargin()">Calculate</button>

  <div id="output"></div>

  <script>
    function calculateMargin() {
      const varVal = parseFloat(document.getElementById("var").value);
      const ltpVal = parseFloat(document.getElementById("ltp").value);
      const qty = parseFloat(document.getElementById("qty").value);
      const percent = parseFloat(document.querySelector('input[name="percent"]:checked').value);

      if (isNaN(varVal) || isNaN(ltpVal) || isNaN(qty)) {
        document.getElementById("output").innerText = "Please enter valid VAR, LTP, and Quantity values.";
        return;
      }

      // Backend logic
      const A = ltpVal * qty;
      const B = A * varVal / 100;
      const C = B * percent / 100;

      document.getElementById("output").innerHTML = `Physical Margin is: ₹${C.toFixed(2)}`;
    }
  </script>

</body>
</html>
